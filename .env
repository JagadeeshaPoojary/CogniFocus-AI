# CogniFocus-AI Environment Configuration

# Flask Server Configuration
PORT=5000
SECRET_KEY=cognifocus_ai_secret_key_prod_demo

# Email Notification Service (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@cognifocus.ai

# SMS Notification Service
SMS_PROVIDER=generic
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=COGNIFOCUS

# Twilio Optional Integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notification Delivery Policy
NOTIFICATION_COOLDOWN_SECONDS=30
